PORT=8787
# For local development, the backend automatically reads the existing Bright Data CLI login.
# Use this variable in deployment instead:
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_SELF_HEAL_COLLECTOR_ID=c_mt30n0l416uiazn4sv
BRIGHT_DATA_COLLECTOR_KAYAK=
BRIGHT_DATA_COLLECTOR_SKYSCANNER=
BRIGHT_DATA_COLLECTOR_TWELVE_GO=
BRIGHT_DATA_COLLECTOR_REDBUS=
BRIGHT_DATA_COLLECTOR_BOOKING=
BRIGHT_DATA_COLLECTOR_EXPEDIA=
BRIGHT_DATA_COLLECTOR_TRIPADVISOR=
# Public URL for the dedicated fixture page, for example https://your-app.example/self-heal-target
SELF_HEAL_TARGET_URL=

# Create a free key in Google AI Studio. This is read only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Reuse exact real searches for 24 hours, and allow a recent snapshot as a no-credit fallback for 7 days.
TRIP_CACHE_TTL_MS=86400000
TRIP_STALE_CACHE_TTL_MS=604800000
# Hard safety rails for fresh Bright Data searches. Cached searches do not count.
TRIP_LIVE_SEARCH_LIMIT_PER_DAY=8
TRIP_MAX_CONCURRENT_SEARCHES=2
# A fallback website is called only when its category has fewer offers than this.
TRIP_MIN_OFFERS_PER_CATEGORY=4
TRIP_AUTO_HEAL_ENABLED=true
TRIP_AUTO_HEAL_MAX_PER_TRIP=1
TRIP_AUTO_HEAL_LIMIT_PER_DAY=2
TRIP_AUTO_HEAL_COOLDOWN_HOURS=24
# On Railway, point this at a mounted volume such as /data/tripweave-cache.
TRIP_CACHE_DIR=
