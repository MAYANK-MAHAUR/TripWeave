PORT=8787
# For local development, the backend automatically reads the existing Bright Data CLI login.
# Use this variable in deployment instead:
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_SELF_HEAL_COLLECTOR_ID=
# Public URL for the dedicated fixture page, for example https://your-app.example/self-heal-target
SELF_HEAL_TARGET_URL=

# Create a free key in Google AI Studio. This is read only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
TRIP_CACHE_TTL_MS=21600000
TRIP_CACHE_DIR=
