{
  "name": "hackathon",
  "version": "1.0.0",
  "description": "TripWeave - complete door-to-door travel comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "npm run test:contracts",
    "test:contracts": "node scripts/integration-contracts.mjs",
    "test:e2e": "node scripts/e2e-dedicated-trip.mjs",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "keywords": [],
